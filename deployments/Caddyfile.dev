# Dev reverse proxy: one origin for API, PWA and TV app (cookies + CSRF stay simple).
{
	auto_https off
	admin off
}

:8080 {
	# Video stream proxy: flush immediately (long-lived Range responses).
	@stream path /api/v1/stream/* /api/v1/vstream/* /api/v1/speedtest
	handle @stream {
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}
	@api path /api/* /healthz /readyz /msx/*
	handle @api {
		reverse_proxy api:8080
	}
	@music path /music /music/*
	handle @music {
		reverse_proxy music:8080 {
			flush_interval -1
		}
	}
	handle /tv/* {
		reverse_proxy tv:5174
	}
	handle {
		reverse_proxy web:5173
	}
}
