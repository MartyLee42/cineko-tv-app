# syntax=docker/dockerfile:1
# Builds the PWA and TV app and serves them (plus the API proxy) with Caddy.
# Build context: repository root.

FROM node:22-bookworm-slim AS build
WORKDIR /repo
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/
COPY apps/tv/package.json apps/tv/
COPY packages/contracts/package.json packages/contracts/
COPY packages/ui/package.json packages/ui/
COPY packages/media-types/package.json packages/media-types/
COPY e2e/package.json e2e/
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter "@martytv/web..." --filter "@martytv/tv..."
COPY apps apps
COPY packages packages
# Build id baked into the apps (client error reports show the release).
ARG VERSION=dev
ENV MARTYTV_VERSION=$VERSION
RUN pnpm --filter @martytv/web --filter @martytv/tv build
# Optional PDF guides (Settings → Инструкции): docs/private/*.pdf, git-ignored.
# Settings hides the card when they're absent.
COPY docs docs
# Served as /docs/martytv-guide.pdf and /docs/install-tv.pdf; *.old.pdf (kept
# copies of previous versions) are not shipped.
RUN mkdir -p /repo/guides && for f in docs/private/*.pdf; do \
      case "$f" in *.old.pdf|"docs/private/*.pdf") ;; *) cp "$f" /repo/guides/ ;; esac; \
    done

FROM caddy:2.10-alpine
COPY deployments/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /repo/apps/web/dist /srv/web
COPY --from=build /repo/apps/tv/dist /srv/tv
COPY --from=build /repo/guides /srv/web/docs
# Earlier releases' hashed assets for pages opened before a deploy: the
# entrypoint adds this build's to the asset archive volume (if mounted at
# /srv/asset-archive) and prunes it; the Caddyfile falls back to it.
COPY --chmod=755 deployments/web-entrypoint.sh /usr/local/bin/web-entrypoint
ENTRYPOINT ["/usr/local/bin/web-entrypoint"]
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
