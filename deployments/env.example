# Cineko configuration: the repository-root `.env` (git-ignored, mode 0600).
# ./install.sh writes it for you (secrets generated); this file documents
# every setting. Manual install: copy to ../.env and fill in the empty values.
# Every secret can instead be read from a file: set NAME_FILE=/path.
# After a change: scripts/cineko.sh up -d (recreates what changed).

# --- Public address ---------------------------------------------------------
# The URL people and TVs use. Encoded in the pairing QR code.
PUBLIC_BASE_URL=https://tv.example.com
# Caddy site address: a domain for automatic HTTPS, or ":80" for LAN-only HTTP
# (then PUBLIC_BASE_URL=http://<lan-ip> and COOKIE_SECURE=false).
SITE_ADDRESS=tv.example.com
# Host ports Caddy is published on (default 80 / 443).
# HTTP_PORT=80
# HTTPS_PORT=443
# Behind Cloudflare / another proxy: trust only its ranges and its client-IP header.
# CADDY_TRUSTED_PROXIES=private_ranges
# CADDY_CLIENT_IP_HEADER=X-Forwarded-For
# Time zone of Prowlarr / FlareSolverr logs.
# TZ=Europe/Berlin
# Image tag of the Cineko images (ghcr.io/martylee42/cineko-tv-app-*): latest,
# a release like 1.2.0, or sha-abc1234. Also the build id when building.
# CINEKO_VERSION=latest
# Extra browser origins allowed to call the API (comma-separated, optional).
ALLOWED_ORIGINS=

# --- Secrets ------------------------------------------------------------------
# 32+ random characters. Generate: openssl rand -base64 48 | tr -d '/+='
# Changing it signs everyone out and unpairs every TV.
APP_SESSION_SECRET=
# Set once before the first start (the database keeps the first value).
POSTGRES_PASSWORD=
# Shared by the API and the transcoder (32+ characters).
TRANSCODER_SECRET=
# Invidious («Видео»): database password, hmac key and the companion key
# (exactly 16 letters/digits).
INVIDIOUS_DB_PASSWORD=
INVIDIOUS_HMAC_KEY=
INVIDIOUS_COMPANION_KEY=
# Prometheus metrics: GET /metrics on api:8080 and music:8080 needs
# "Authorization: Bearer <this>"; empty = /metrics answers 404. Never
# published by Caddy (docs/deployment.md "Metrics").
METRICS_TOKEN=

# --- Torrents (bundled services) ----------------------------------------------
# Prowlarr (torrent search). install.sh copies its API key here from
# Prowlarr's config.xml; or Prowlarr UI → Settings → General → API Key.
# Point the URLs elsewhere to use your own existing instances instead.
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=
# Host ports (127.0.0.1 only) of the Prowlarr / TorrServer web UIs, for setup
# through an SSH tunnel.
# PROWLARR_UI_PORT=9696
# TORRSERVER_UI_PORT=8090

# Jacred torrent index (sources provider "jacred"; results join Prowlarr's).
# Default: the public instance. JACRED_URL=off disables it. Admin → Sources
# can also switch it off or override the URL without a restart.
# JACRED_URL=https://jr.maxvol.pro
# JACRED_API_KEY=

# TorrServer (torrent → HTTP streaming). Only Cineko talks to it.
TORRSERVER_URL=http://torrserver:8090
# Only when TorrServer basic auth is on (TS_HTTPAUTH=1 + accs.db, see
# docs/deployment.md). Also accepted: TORRSERVER_LOGIN / TORRSERVER_PWD
# TS_HTTPAUTH=0
TORRSERVER_USERNAME=
TORRSERVER_PASSWORD=
# TorrServer's own settings, applied by scripts/torrserver-settings.sh
# (install.sh and update.sh run it; written only when they differ).
# TORRSERVER_CACHE_MB=128                 # RAM cache per torrent
# TORRSERVER_REMOVE_CACHE_ON_DROP=true    # free the cache when a torrent closes
# TORRSERVER_RUTOR_SEARCH=false           # TorrServer's built-in rutor search

# --- Outbound proxy (where TMDB / YouTube are blocked) ---------------------------
# One proxy for TMDB (API), Invidious + companion (YouTube) and music
# (Deezer / LRCLIB). Empty = everything goes direct. Schemes: socks5h://,
# socks5://, http://, credentials allowed (http://user:pass@host:port).
# The bundled VPN client: COMPOSE_PROFILES=vpn, settings in ../gluetun.env,
# OUTBOUND_PROXY_URL=http://gluetun:8888.
# OUTBOUND_PROXY_URL=
# COMPOSE_PROFILES=
# Invidious needs the same proxy as a YAML map (install.sh derives it):
# INVIDIOUS_HTTP_PROXY={type: socks5, host: "proxy.example", port: 1080}
# Per-service overrides (default: OUTBOUND_PROXY_URL): TMDB_PROXY_URL,
# MUSIC_PROXY_URL, COMPANION_PROXY.

# --- TMDB (catalog metadata) -------------------------------------------------
# Either the v4 read access token (preferred) or the v3 API key.
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
# Override only to use a TMDB mirror / reverse proxy.
# TMDB_BASE_URL=https://api.themoviedb.org/3
# TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
# Route TMDB API + image traffic through a proxy, e.g. where TMDB is blocked;
# set IMAGE_PROXY=true too so clients load images via the server.
# Schemes: http, https, socks5, socks5h. Credentials in the URL are allowed.
# Default: OUTBOUND_PROXY_URL.
# TMDB_PROXY_URL=socks5h://proxy.example:1080

# --- Catalog ------------------------------------------------------------------
# Default watch-provider region (ISO 3166-1 alpha-2).
# CATALOG_REGION=RU
# Serve TMDB images through /api/v1/images (cached on disk) instead of letting
# clients load image.tmdb.org directly. Use for TVs without direct internet
# access or where image.tmdb.org is blocked.
# IMAGE_PROXY=false
# IMAGE_CACHE_DIR=/var/cache/martytv/images   # set by compose.yaml (the cache volume)

# --- Intro / credits times («Пропустить заставку») ------------------------------
# Keyless community databases, by TMDB / IMDb id (via TMDB_PROXY_URL if set).
# off = disable one.
# THEINTRODB_URL=https://api.theintrodb.org
# INTRODB_URL=https://api.introdb.app

# --- Ratings (Kinopoisk / IMDb) ------------------------------------------------
# Ratings themselves come keyless from rating.kinopoisk.ru. TMDB titles are
# mapped to Kinopoisk ids through Wikidata first (keyless, batched); the key
# is only the fallback for titles Wikidata doesn't know.
# KINOPOISK_WIKIDATA_URL=https://query.wikidata.org/sparql   # off = disable (also disables film awards from Wikidata)
# Free keys: register at https://kinopoiskapiunofficial.tech (500 req/day), or
# kinopoisk.dev / poiskkino.dev via Telegram @kinopoiskdev_bot (PROVIDER=dev).
# KINOPOISK_API_KEY=
# KINOPOISK_PROVIDER=unofficial        # unofficial | dev
# KINOPOISK_DAILY_BUDGET=450           # id lookups per Moscow day (keep under the key's quota)
# Kinopoisk is reachable directly from Russia; set a proxy only if needed.
# KINOPOISK_PROXY_URL=

# --- Recommendations («Для вас», Phase 6) -------------------------------------
# AI collections (подборки) via DeepSeek (OpenAI-compatible API). Without a key
# AI is off and everything else (rows, Surprise Me, Explore) still works.
# Never logged. DEEPSEEK_API_KEY_FILE=/path also works.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Token caps: per Moscow day and per run (a call is ~2-3k tokens).
# FORYOU_AI_DAILY_TOKENS=300000
# FORYOU_AI_RUN_TOKENS=200000
# Daily recommendations run, Moscow time (HH:MM, or "off").
# FORYOU_DAILY_AT=05:00
# «Новые серии»: nightly check for new episodes of each profile's series
# (HH:MM in NEW_EPISODES_TZ, or off), and the TMDB language of episode titles.
# NEW_EPISODES_AT=04:00
# NEW_EPISODES_TZ=Europe/Moscow
# NEW_EPISODES_LANG=ru
# Nightly Invidious restart (docs/deployment.md): HH:MM or off, in
# INVIDIOUS_RESTART_TZ (default: TZ, else NEW_EPISODES_TZ, else UTC). Postponed
# every 15 min while a YouTube video plays; skipped after 2 h.
# INVIDIOUS_RESTART_AT=03:00
# INVIDIOUS_RESTART_TZ=Europe/Berlin
# TMDB detail fetches (cast/crew of rated titles) per profile per run.
# FORYOU_CREDITS_PER_PROFILE=150
# «Спросить ИИ» questions per account per Moscow day (they also count toward
# FORYOU_AI_DAILY_TOKENS; ~1-2k tokens each).
# FORYOU_ASK_DAILY_PER_USER=30

# --- Browser compatibility streams (services/transcoder) ---------------------
# The API asks the transcoder sidecar to remux torrents to MP4 with AAC audio
# for browsers that can't play the original (AC3/DTS/TrueHD, MKV on Safari).
# Unset = off (PlaybackSource.compat_url is null). Same secret on both sides.
# compose.yaml sets TRANSCODER_URL=http://transcoder:8090; the secret is above.
# Transcoder container only: TRANSCODER_MAX_JOBS=3, TRANSCODER_IDLE_TIMEOUT=2m,
# TRANSCODER_MAX_DURATION=6h, TRANSCODER_NICE=10, TRANSCODER_SUBTITLE_READRATE=4,
# TRANSCODER_VIDEO_THREADS=2 (libx264 threads per stream that re-encodes XviD/MPEG-2 video)
# GPU re-encoding (docs/deployment.md "GPU transcoding"; the GPU must also be
# passed to the container in compose.override.yaml):
# TRANSCODER_HWACCEL=auto                 # auto | none | nvenc | vaapi | qsv
# TRANSCODER_HWACCEL_DEVICE=              # render node for vaapi/qsv (default: the first /dev/dri/renderD*)
# RENDER_GID=109                          # host's `render` group id (compose.override.yaml group_add)

# --- Server downloads («Скачать на сервер») -----------------------------------
# Full copies of torrent files kept on the server's disk (docs/architecture.md
# "Server downloads"). Reserve, library cap and keep days are set in
# Admin → «Хранилище» (defaults 15 GB / unlimited / 30 days).
# LIBRARY_DIR=/var/cache/martytv/library  # compose.yaml default: inside the API's cache volume;
#                                         # a bigger disk: docs/deployment.md "Server downloads"
#                                         # (must be writable by the API, uid 65532)
# DOWNLOAD_MAX_JOBS=2                     # downloads reading TorrServer at once (1…8)
# INTERNAL_API_URL=http://api:8080        # how the transcoder reaches the API (compat of downloaded files)

# --- IPTV (live TV, Phase 7) ----------------------------------------------------
# Playlists are added in Admin → IPTV (iptv-org country presets, provider M3U
# URLs or uploaded files). Proxy for playlists/guides/logos marked "via proxy"
# and the automatic fallback when a direct fetch fails; default TMDB_PROXY_URL.
# IPTV_PROXY_URL=socks5h://proxy.example:1080
# IPTV_ORG_BASE_URL=https://iptv-org.github.io/iptv     # <base>/countries/<code>.m3u
# IPTV_ORG_API_URL=https://iptv-org.github.io/api       # channels.json (alt names for EPG matching)
# Guides of iptv-org presets: unset = the built-in per-country lists
# (iptvx.one, epg.pw, epg.it999.ru, epgshare01; docs/architecture.md "IPTV").
# Override with comma-separated templates ({CC}/{cc} = country code), or "off".
# IPTV_ORG_EPG_URL=https://epg.pw/xmltv/epg_{CC}.xml.gz
# Allow playlists/streams on private (LAN) addresses, e.g. a provider udpxy.
# IPTV_ALLOW_PRIVATE=false
# IPTV_REFRESH_HOURS=12
# IPTV_EPG_REFRESH_HOURS=6

# --- Video («Видео», YouTube via a self-hosted Invidious) ---------------------
# The bundled Invidious (compose service "invidious", the default). Must match
# Invidious' own domain / external_port (stream URLs carry that origin).
# Invidious and companion reach YouTube directly, or through
# OUTBOUND_PROXY_URL; their secrets are above.
# INVIDIOUS_URL=http://invidious:3000
# VIDEO_REGION=RU                       # region for trending/search/videos (keep RU)
# VIDEO_LANG=ru                         # hl sent to Invidious (its own strings, e.g. "2 дня назад")

# --- Music (/music, services/music) ----------------------------------------------
# A separate container; it reads this same file (PROWLARR_*, TORRSERVER_*).
# Catalog: Deezer's public API (no key). Audio: YouTube through INVIDIOUS_URL,
# cached on its disk. Lyrics: LRCLIB. Accounts: Cineko sessions.
# MUSIC_CACHE_GB=10                 # YouTube audio disk cache (0 = off)
# MUSIC_MAX_TRANSCODES=4            # ffmpeg jobs (CUE images, formats browsers can't play)
# MUSIC_REGION=RU                   # YouTube search region
# MUSIC_PROXY_URL=                  # proxy for Deezer / LRCLIB / covers (default OUTBOUND_PROXY_URL)
# AI playlists use DEEPSEEK_API_KEY; usage is kept in music.db per Moscow day.
# MUSIC_AI_DAILY_PER_USER=40        # AI playlists per account per day
# MUSIC_AI_DAILY_TOKENS=150000      # DeepSeek tokens per day, all accounts (0 = unlimited; ~2-3k per playlist)
# DEEZER_URL=https://api.deezer.com
# LRCLIB_URL=https://lrclib.net

# --- Optional -----------------------------------------------------------------
# Unix socket of the optional martytv-hostmon host service (admin Server tab,
# docs/deployment.md "Host monitor"). Missing socket → the tab shows the API
# container's own view.
# HOSTMON_SOCKET=/run/martytv/hostmon.sock
# LOG_LEVEL=info
# SESSION_IDLE_TTL=720h
# SESSION_ABSOLUTE_TTL=2160h
# PAIRING_TTL=5m
# COOKIE_SECURE=true        # defaults from PUBLIC_BASE_URL's scheme

# --- Media Station X launcher -------------------------------------------------
# Extra buttons next to Cineko in the MSX menu (JSON array). Default: Lampa.
# MSX_APPS=[{"label":"Lampa","icon":"movie","url":"http://lampa.mx/"}]
# Load the launcher through the Cineko MSX bridge plugin (enables playing in
# MSX's native player). Set to false for a plain static menu.
# MSX_BRIDGE=true
