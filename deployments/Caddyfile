# Production reverse proxy and static file server.
#
# SITE_ADDRESS: a domain (e.g. tv.example.com) gets automatic HTTPS from
# Let's Encrypt; ":80" serves plain HTTP on the LAN.
# MUSIC_SITE_ADDRESS: Cineko Music on its own host (MUSIC_DOMAIN in .env,
# e.g. music.example.com, automatic HTTPS too). Unset = a placeholder that
# never matches a real request; /music/ on the main host works either way.
{
	admin off
	servers {
		# Behind Cloudflare (or another CDN): trust only its ranges and take the
		# client IP from its header, so X-Forwarded-For can't be spoofed by
		# requests that bypass the CDN. Defaults suit a LAN or a plain proxy.
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:private_ranges}
		client_ip_headers {$CADDY_CLIENT_IP_HEADER:X-Forwarded-For}
	}
}

# Compression and headers shared by both sites.
(common) {
	# Never compress the video stream proxy (it would break Range requests)
	# nor the speed test (random bytes; it must time the raw link).
	@compressible not path /api/v1/stream/* /api/v1/vstream/* /api/v1/speedtest /music/api/play/* /music/api/stream/* /music/api/yt/*
	encode @compressible zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# An app's hashed assets (/assets/*, immutable): this build's, else the asset
# archive's — earlier releases' files, which pages opened before a deploy
# still ask for (deployments/web-entrypoint.sh fills it) — else a 404 that is
# never cached and never the app's index.html.
# {args[0]}: the build, {args[1]}: its directory in the archive.
(hashed_assets) {
	@current file {
		root {args[0]}
	}
	@archived file {
		root {args[1]}
	}
	handle @current {
		root * {args[0]}
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle @archived {
		root * {args[1]}
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		header Cache-Control "no-store"
		respond 404
	}
}

# The Cineko API (both sites: Music signs in and reads settings through it).
(api) {
	# Video stream proxy: flush immediately, no buffering, no timeouts
	# (a film can stream for hours; Range requests pass through).
	# /api/v1/vstream: YouTube videos («Видео», byte-range fMP4).
	# /api/v1/speedtest: background speed tests time the bytes as they arrive.
	@stream path /api/v1/stream/* /api/v1/vstream/* /api/v1/speedtest
	handle @stream {
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
		}
	}

	# API, realtime WebSocket, liveness and the Media Station X launch files.
	# /readyz stays internal (it reports integration status).
	@api path /api/* /healthz /msx/*
	handle @api {
		reverse_proxy api:8080 {
			# Pass the real client IP (rate limits, audit log).
			header_up X-Forwarded-For {client_ip}
		}
	}
}

# Cineko Music (services/music): its own app, API and audio streams.
# Audio is flushed immediately and never buffered (Range requests pass
# through; a track or a transcode can stream for a long time).
(music) {
	reverse_proxy music:8080 {
		header_up X-Forwarded-For {client_ip}
		flush_interval -1
	}
}

{$SITE_ADDRESS::80} {
	import common
	import api

	@music path /music /music/*
	handle @music {
		import music
	}

	# «Демо TV»: the TV app in a browser signed in to the PWA, without
	# pairing (apps/tv/src/demo.ts; the PWA has the same route for its
	# service worker).
	@demotv path /demo_tv /demo_tv/
	redir @demotv /tv/?demo=1 302

	# TV app (built with base /tv/).
	handle_path /tv/* {
		handle /assets/* {
			import hashed_assets /srv/tv /srv/asset-archive/tv
		}
		handle {
			root * /srv/tv
			# The start page must always be re-checked, or TV browsers keep
			# running an old build after a deploy.
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}

	# PWA.
	handle /assets/* {
		import hashed_assets /srv/web /srv/asset-archive/web
	}
	handle {
		root * /srv/web
		# index.html (also for app routes), sw.js, the manifest: always
		# re-checked after a deploy.
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Cineko Music as its own app (an installable PWA with scope "/"): the music
# service serves the app built for "/" at the root and its API at
# /music/api; /api/* is the Cineko API (sign-in, settings), same-origin.
{$MUSIC_SITE_ADDRESS:http://music.invalid} {
	import common
	import api

	# The music service's metrics are for the internal network only.
	@metrics path /metrics /metrics/*
	handle @metrics {
		respond 404
	}

	handle {
		import music
	}
}
