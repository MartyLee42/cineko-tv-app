{
  "name": "martytv",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen": "pnpm --filter @martytv/contracts gen",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "build": "pnpm --filter @martytv/web --filter @martytv/tv build",
    "e2e": "pnpm --filter @martytv/e2e e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "type": "module"
}
