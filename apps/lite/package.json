{
  "name": "cineko-lite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cineko Lite: serverless TMDB + CDNVideoHub player for the browser and Media Station X",
  "scripts": {
    "dev": "vite --mode web",
    "dev:tv": "vite --mode tv",
    "build": "npm run build:web && npm run build:tv && node scripts/assemble.mjs",
    "build:web": "vite build --mode web",
    "build:tv": "vite build --mode tv",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "preview": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/onest": "5.3.1",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/rubik-mono-one": "5.3.0",
    "@fontsource/russo-one": "5.3.0",
    "@fontsource/unbounded": "5.3.0",
    "hls.js": "1.7.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-legacy": "8.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "terser": "5.51.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
